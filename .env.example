# Copy to .env for a local run; on the server set these in Coolify. Never commit .env.

# From @BotFather (/newbot). Anyone with it can act as the bot.
TELEGRAM_BOT_TOKEN=
# Required. Your Telegram user ID (numbers), from @userinfobot. Several people: comma-separated.
# Everyone else gets no reply.
ALLOWED_USER_IDS=

# Coolify API (Keys & Tokens → API tokens), with the "deploy" and "read" permissions.
# Logs may also need "read:sensitive".
COOLIFY_URL=http://13.140.173.69:8000
COOLIFY_TOKEN=

# Optional: name:coolify-app-uuid pairs (these are the defaults)
