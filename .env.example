# Copy to .env for a local run; on the server set these in Coolify. Never commit .env.

# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# The same random value as BOT_API_SECRET on the backend (at least 32 characters).
# The bot uses it to check sign-ins against the admin accounts.
BOT_API_SECRET=
# The store API (defaults to the current backend address)
# API_URL=https://kss2ucneseuomueurdbmysqa.13.140.173.69.sslip.io

# Coolify API (Keys & Tokens → API tokens) with the "deploy", "read" and "read:sensitive" permissions.
COOLIFY_URL=http://13.140.173.69:8000
COOLIFY_TOKEN=

# Optional extra lock: comma-separated Telegram user IDs (from @userinfobot) that may even try to
# sign in. Everyone else gets no reply. Empty = anyone can try, but needs owner email, password and 2FA.
ALLOWED_USER_IDS=

# Optional: name:coolify-app-uuid pairs (these are the defaults)
# APPS=backend:kss2ucneseuomueurdbmysqa,admin:lu4ijxuv9xjccx5mu6k5sgq0,storefront:owxmr2x8cjhjnctsvrkgh5rx
